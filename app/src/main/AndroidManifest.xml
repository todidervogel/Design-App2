<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Version 1 ist reine Oberflaeche. Es werden bewusst keine Berechtigungen
      angefordert: keine Kamera, keine Sensoren, keine Bedienungshilfe, kein
      Geraete-Admin, kein Netz. Der Berechtigungs-Schritt im Onboarding zeigt
      nur Zustaende an.
    -->

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="false"
        android:theme="@style/Theme.Relock">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:label="@string/app_name"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Relock">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
