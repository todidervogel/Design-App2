<?xml version="1.0" encoding="utf-8"?>
<!--
  Vier Eckwinkel, wie das BoxOverlay in der App: das Handy liegt in der Box.
  Motiv sitzt im sicheren Bereich (Mitte 72 von 108 dp).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Karolinien, sehr zurueckhaltend -->
    <path
        android:pathData="M42,30 L42,78 M54,30 L54,78 M66,30 L66,78 M30,42 L78,42 M30,54 L78,54 M30,66 L78,66"
        android:strokeColor="#1D3A9E"
        android:strokeWidth="0.8"
        android:strokeAlpha="0.25" />

    <!-- Eckwinkel oben links -->
    <path
        android:pathData="M30,42 L30,30 L42,30"
        android:strokeColor="#1D3A9E"
        android:strokeWidth="5"
        android:strokeLineCap="square" />
    <!-- oben rechts -->
    <path
        android:pathData="M66,30 L78,30 L78,42"
        android:strokeColor="#1D3A9E"
        android:strokeWidth="5"
        android:strokeLineCap="square" />
    <!-- unten rechts -->
    <path
        android:pathData="M78,66 L78,78 L66,78"
        android:strokeColor="#1D3A9E"
        android:strokeWidth="5"
        android:strokeLineCap="square" />
    <!-- unten links -->
    <path
        android:pathData="M42,78 L30,78 L30,66"
        android:strokeColor="#1D3A9E"
        android:strokeWidth="5"
        android:strokeLineCap="square" />

    <!-- Textmarker-Streifen, leicht schraeg: das eine auffaellige Element -->
    <path
        android:pathData="M37,60 L71,55 L71,64 L37,69 Z"
        android:fillColor="#F3E03B"
        android:fillAlpha="0.9" />
</vector>
