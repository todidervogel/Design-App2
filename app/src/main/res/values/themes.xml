<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Heft-Look. Nur das Fenster selbst, alles weitere macht Compose.
      Kein ActionBar, damit der Compose-Screen die volle Flaeche hat.
    -->
    <style name="Theme.Kopfgeld" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/papier</item>
        <item name="android:statusBarColor">@color/papier</item>
        <item name="android:navigationBarColor">@color/papier</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
