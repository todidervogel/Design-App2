<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Relock hat in Version 1 nur ein einziges dunkles Theme.
      Das Fenster ist deshalb immer Nacht, unabhaengig vom Systemtheme.
    -->
    <style name="Theme.Relock" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/nacht</item>
        <item name="android:statusBarColor">@color/nacht</item>
        <item name="android:navigationBarColor">@color/nacht</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
